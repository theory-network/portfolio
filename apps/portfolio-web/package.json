{
  "name": "@theory/portfolio-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 4200 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4200 --strictPort",
    "prerender": "node prerender.mjs"
  },
  "dependencies": {
    "@theory/common-shadcn": "*",
    "@theory/ui": "*",
    "@module-federation/runtime": "^2.4.0",
    "@tanstack/react-router": "^1.95.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.13"
  },
  "nx": {
    "projectType": "application",
    "sourceRoot": "apps/portfolio-web/src",
    "tags": [
      "scope:portfolio-web",
      "type:consumer"
    ],
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "vite",
          "cwd": "apps/portfolio-web"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vite build",
          "cwd": "apps/portfolio-web"
        }
      },
      "prerender": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node prerender.mjs",
          "cwd": "apps/portfolio-web"
        }
      }
    }
  }
}
