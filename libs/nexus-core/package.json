{
  "name": "@theory/nexus-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": ["{options.outputPath}"],
        "options": {
          "outputPath": "libs/nexus-core/dist",
          "main": "libs/nexus-core/src/index.ts",
          "tsConfig": "libs/nexus-core/tsconfig.lib.json"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "libs/nexus-core",
          "command": "tsc -p tsconfig.lib.json --noEmit"
        }
      }
    }
  }
}
