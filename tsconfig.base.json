{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "@org/source"
    ],
    "noUncheckedSideEffectImports": false,
    "types": [
      "*"
    ],
    "paths": {
      "@shadcn/components": [
        "./libs/shadcn/src/components/index.ts"
      ],
      "@shadcn/util": [
        "./libs/shadcn/src/util/index.ts"
      ],
      "@shadcn/hooks": [
        "./libs/shadcn/src/hooks"
      ],
      "@shadcn": [
        "./libs/shadcn/src/components"
      ]
    }
  }
}
